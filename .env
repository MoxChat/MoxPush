# MoxPush default environment for direct binary deployment.
# Copy this file and replace database credentials and Apple Developer APNs values.
# Do not commit real .p8 private keys or Apple account secrets to a public repository.

MOXPUSH_ADDR=:8983
MOXPUSH_DB_DSN=postgres://moxpush:change-me@127.0.0.1:5432/moxpush?sslmode=disable
MOXPUSH_PUBLIC_BASE_URL=

# APNs credentials.
MOXPUSH_APNS_TEAM_ID=YOUR_TEAM_ID
MOXPUSH_APNS_KEY_ID=YOUR_KEY_ID
MOXPUSH_APNS_BUNDLE_ID=com.example.moxchat
MOXPUSH_APNS_VOIP_BUNDLE_ID=com.example.moxchat.voip
MOXPUSH_APNS_PRIVATE_KEY_FILE=/secure/path/AuthKey_YOUR_KEY_ID.p8
MOXPUSH_APNS_PRIVATE_KEY=
MOXPUSH_APNS_ENVIRONMENT=development

MOXPUSH_AUTH_FAIL_WINDOW_MINUTES=30
MOXPUSH_AUTH_FAIL_BAN_MINUTES=30
MOXPUSH_AUTH_FAIL_BAN_THRESHOLD=10
